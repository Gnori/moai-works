{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/tools/sync_skills.py\" --hook --min-interval 0 --target \"$CLAUDE_PROJECT_DIR/.claude/skills\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/tools/sync_skills.py\" --hook --target \"$CLAUDE_PROJECT_DIR/.claude/skills\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
